#!/usr/bin/env bash
# Commit-Date: 2026-10-06T21:45:00Z
# Commit-Version: 0.1.0-20261006214500
# Autor: Antonio Duce
# Commit-Version y Commit-Date se actualizan antes de cada commit.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"
COMMIT_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
COMMIT_VERSION="0.1.0-$(date -u +%Y%m%d%H%M%S)"

if [[ -n "${GRADLE_HOME:-}" && -x "$GRADLE_HOME/bin/gradle" ]]; then
  "$GRADLE_HOME/bin/gradle" updateMetadata -PcommitDate="$COMMIT_DATE" -PcommitVersion="$COMMIT_VERSION" --no-daemon
elif [[ -x "/c/dev/tools/gradle/bin/gradle" ]]; then
  "/c/dev/tools/gradle/bin/gradle" updateMetadata -PcommitDate="$COMMIT_DATE" -PcommitVersion="$COMMIT_VERSION" --no-daemon
elif command -v gradle >/dev/null 2>&1; then
  gradle updateMetadata -PcommitDate="$COMMIT_DATE" -PcommitVersion="$COMMIT_VERSION" --no-daemon
elif command -v gradle.bat >/dev/null 2>&1; then
  gradle.bat updateMetadata "-PcommitDate=$COMMIT_DATE" "-PcommitVersion=$COMMIT_VERSION" --no-daemon
else
  echo "No se encontro Gradle; no se puede actualizar metadata." >&2
  exit 1
fi

git add -A
